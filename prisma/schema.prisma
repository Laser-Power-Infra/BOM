// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum RuleOperator {
  gt
  lt
  eq
}

enum RuleOutput {
  PLUS_PLUS
  PLUS
  ZERO
  MINUS
  MINUS_MINUS
}

model Map {
  id        Int    @id @default(autoincrement())
  
  mapA      String
  mapB      String

  output String
  ccvsiovalue String?
  alcuValue String?
  outputText String?
  Rules Rule[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rule {
  id       Int          @id @default(autoincrement())
  label    String
  value    String
  category String?

  mapId Int?
  Map Map? @relation(fields: [mapId], references: [id], onDelete: Cascade)

  operator RuleOperator
  output   RuleOutput

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemSchedule {
  id              Int      @id @default(autoincrement())

  itemCode        String   
  itemScheduleName String
  sheetTotalDiff   String?
  bomType          String?
  bomId               String
  option2             String?
  option2Diff         String?
  ccvSioplas          String?
  ccvSioplasDiff      String?
  cuTape              String?
  cuTapePlusMinus     String?
  cuTapeDiff          String?
  alCu                String?
  alCuPlusMinus       String?
  alCuDiff            String?
  alloy               String?
  alloyPlusMinus      String?
  alloyDiff           String?
  armour              String?
  armourPlusMinus     String?
  armourDiff          String?
  semicon             String?
  semiconPlusMinus    String?
  semiconDiff         String?
  insulation          String?
  insulationPlusMinus String?
  insulationDiff      String?
  pvcInner            String?
  pvcInnerPlusMinus   String?
  pvcInnerDiff        String?
  pvcOuter            String?
  pvcOuterPlusMinus   String?
  pvcOuterDiff        String?
  pvcOuterInnerDiff     String?
  filler              String?
  fillerPlusMinus     String?
  fillerDiff          String?
  polyt               String?
  polytPlusMinus      String?
  polytDiff           String?
  rubberCottonTape    String?
  rubberCottonTapePlusMinus String?
  rubberCottonTapeDiff String?
  spclConstruction    String?
  spclConstructionPlusMinus String?
  spclConstructionDiff String?

  finalOutput String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([itemCode, bomId])
}
